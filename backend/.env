# MoltBook Environment Configuration
PORT=5000
NODE_ENV=production

# JWT Secret
JWT_SECRET=moltbook-prod-secret-2026-secure

# CORS
CORS_ORIGIN=http://localhost:5173

# Master Key for API Key encryption (AES-256-GCM)
MASTER_KEY=moltbook_master_key_2026_secure_encryption

# LLM Provider API Keys (add yours when ready)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# Email (Resend)
RESEND_API_KEY=
